# Database (Neon)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host/db?sslmode=require

# App
NEXT_PUBLIC_APP_URL=https://imagesmith.vercel.app

# Rate limiting (Upstash Redis)
UPSTASH_REDIS_REST_URL=https://example.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# Auth (Better Auth). Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://imagesmith.vercel.app

# Optional: only this account counts as admin (recommended)
ADMIN_EMAIL=
# Optional: comma-separated IPs excluded from page-view/conversion stats
ADMIN_IPS=
# Leave UNSET in production. Set to "true" only to seed a new admin account,
# then remove it and redeploy.
# ALLOW_SIGNUP=true

# NEVER put secrets in NEXT_PUBLIC_* variables: they ship to the browser.
